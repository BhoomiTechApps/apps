{
  "id": "./",
  "name": "Jhola – Shopping List",
  "short_name": "Jhola",
  "description": "Make shopping lists from your own picture catalog, keep prices up to date and share lists on WhatsApp.",
  "lang": "en-IN",
  "start_url": "./#shop",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e8e6e0",
  "theme_color": "#d8d5ce",
  "categories": ["shopping", "lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "screenshots": [
    { "src": "screenshots/shop.png", "sizes": "800x1720", "type": "image/png", "form_factor": "narrow", "label": "Tap pictures to build your list" },
    { "src": "screenshots/list.png", "sizes": "800x1720", "type": "image/png", "form_factor": "narrow", "label": "Your list with prices and budget" },
    { "src": "screenshots/share.png", "sizes": "800x1720", "type": "image/png", "form_factor": "narrow", "label": "Share the list as a picture" }
  ],
  "shortcuts": [
    { "name": "My list", "url": "./#list", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add to catalog", "url": "./#catalog", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
