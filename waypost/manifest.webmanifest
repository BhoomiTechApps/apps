{
  "name": "Waypost",
  "short_name": "Waypost",
  "description": "Build your own map of places and tracks, plan routes on them and replay the journey.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#d8d5ce",
  "theme_color": "#d8d5ce",
  "categories": [
    "travel",
    "navigation"
  ],
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".json"
        ],
        "application/geo+json": [
          ".geojson"
        ]
      }
    }
  ]
}