{
  "name": "Street Journey Lite",
  "short_name": "SJ Lite",
  "description": "Play a motorcycle ride through your own map points.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1d1e20",
  "theme_color": "#1d1e20",
  "categories": ["travel", "navigation"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".json"], "application/geo+json": [".geojson"] } }
  ]
}
