{
  "name": "LexiPic Kiosk — Heritage Language Archive",
  "short_name": "LexiPic Kiosk",
  "description": "A touchscreen kiosk for browsing heritage-language word sets — image and audio flashcards for endangered and minority languages such as Bishnupriya Manipuri, Assamese, and Bengali.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/lexipic-kiosk/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#3d2c1f",
  "theme_color": "#3d2c1f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "reference"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
