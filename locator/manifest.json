{
  "id": "./",
  "name": "GeoTag: Location & Photo Mapper",
  "short_name": "GeoTag",
  "description": "Capture site photos with GPS coordinates, keep them offline, and export them as photos, CSV, GeoJSON and KML.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#edf1f6",
  "theme_color": "#1d4ed8",
  "categories": ["productivity", "utilities", "navigation"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New capture",
      "short_name": "Capture",
      "url": "./?action=capture",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Captures",
      "short_name": "Captures",
      "url": "./?action=captures",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "image", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"] }
      ]
    }
  }
}
