{
  "name": "OSM Digitizer",
  "short_name": "Digitizer",
  "description": "Pull roads, rivers, wetlands, land cover and village names from OpenStreetMap, or trace them from a map image, and export GeoJSON, KML, Shapefile or DXF.",
  "id": "/apps/osm-digitizer",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#d8d5ce",
  "theme_color": "#d8d5ce",
  "categories": ["navigation", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
