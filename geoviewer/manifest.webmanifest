{
  "id": "./",
  "name": "GeoViewer",
  "short_name": "GeoViewer",
  "description": "View, style and edit GeoJSON maps: layers, attribute tables, search, distance, area and routing tools. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#d8d5ce",
  "theme_color": "#d8d5ce",
  "lang": "en",
  "dir": "ltr",
  "categories": ["navigation", "utilities", "productivity"],
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/geo+json": [".geojson"],
        "application/json": [".json"]
      },
      "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
