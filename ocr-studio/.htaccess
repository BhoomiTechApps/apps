# OCR Studio — optional, for Apache hosts (ignored by GitHub Pages).
# The service worker already sends direct visits to script and style files
# back to index.html once the app has been opened. These rules do the same on
# the very first visit, before the service worker is installed.

Options -Indexes

# File types some Apache versions do not know (speech engine for Listen).
AddType text/javascript .mjs
AddType application/wasm .wasm
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Opened as a page (address bar, link, "open in new tab", view source).
  RewriteCond %{HTTP:Sec-Fetch-Dest} ^document$ [NC]
  RewriteRule \.(?:m?js|css|map)$ index.html [R=302,L]
</IfModule>
